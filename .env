# ==========================================
# .env y configurar según su ambiente
# ==========================================

# CONFIGURACIÓN BÁSICA DE DJANGO
SECRET_KEY=tu-clave-secreta-muy-segura-aqui
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,tu-dominio.com

# BASE DE DATOS
# Para PostgreSQL (recomendado para producción)
DB_NAME=gestion_empleados
DB_USER=postgres
DB_PASSWORD=123456
DB_HOST=localhost
DB_PORT=5432

# Para usar SQLite en desarrollo (más simple)
#USE_SQLITE=True

# REDIS (opcional - para caché y Celery)
USE_REDIS=False
REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# CONFIGURACIÓN DE EMAIL
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Para producción con Gmail:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=tu-email@gmail.com
# EMAIL_HOST_PASSWORD=tu-app-password
DEFAULT_FROM_EMAIL=noreply@empresa.com

# INFORMACIÓN DE LA EMPRESA
EMPRESA_NOMBRE=Mi Empresa S.A.S.
EMPRESA_NIT=900123456-1
EMPRESA_DIRECCION=Calle 123 # 45-67, Bogotá
EMPRESA_TELEFONO=+57 1 234 5678
EMPRESA_EMAIL=info@miempresa.com
EMPRESA_LOGO=img/logo.png

# CONFIGURACIÓN DE ARCHIVOS
# Tamaños máximos en bytes (5MB = 5242880)
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880
DATA_UPLOAD_MAX_MEMORY_SIZE=5242880

# MONITOREO Y LOGGING (opcional)
# SENTRY_DSN=https://tu-sentry-dsn@sentry.io/proyecto

# CONFIGURACIÓN DE DESARROLLO
# Usar para mostrar toolbar de debug
SHOW_DEBUG_TOOLBAR=True

# CONFIGURACIÓN DE SEGURIDAD (solo para producción)
# SECURE_SSL_REDIRECT=True
# SECURE_BROWSER_XSS_FILTER=True
# SECURE_CONTENT_TYPE_NOSNIFF=True
# X_FRAME_OPTIONS=DENY
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True